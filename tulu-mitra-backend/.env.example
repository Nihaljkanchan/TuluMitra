# Copy to .env and edit. Never commit .env.

# Which websites may call this API (comma-separated). Use your real
# frontend address in production, e.g. https://tulu-mitra.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional: a language model for open questions and AI translation.
# Set ONE of these keys (remove the # in front):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5

# Text corpus used by the dictionary (already included, cleaned)
CORPUS_FILE=data/Tulu_Corpus_clean.txt

# Speech. "auto" uses whatever is installed; "off" disables.
ASR_MODE=auto
ASR_ALLOW_BASE_MODEL=true
WHISPER_BASE_MODEL=openai/whisper-small
TTS_MODE=auto
TTS_KANNADA_PROXY=true
# Indian voice (needs: pip install git+https://github.com/huggingface/parler-tts.git)
INDIC_TTS_ENABLED=true
# Suresh (male) or Anu (female)
TTS_SPEAKER=Suresh
# Personalised voice via kNN-VC: knnvc | off
VOICE_CONVERSION=off

# Admin page password (review mistake reports, edit words, lessons, greetings).
# Empty = Admin page switched off.
ADMIN_PASSWORD=
